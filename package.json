{
  "name": "unofficial-messenger-desktop",
  "productName": "Unofficial Messenger Desktop",
  "version": "1.1.1",
  "description": "Cross-platform unofficial desktop wrapper for Facebook Messages",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "test": "node --test",
    "check": "npm test && node --check src/main.js && node --check src/preload.js && node --check src/security.mjs && node --check src/context-menu.mjs && node --check src/badge-icon.mjs && node --check src/update-checker.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin",
    "make:win": "electron-forge make --platform=win32",
    "make:linux": "electron-forge make --platform=linux",
    "prepare:release-assets": "node scripts/prepare-release-assets.mjs"
  },
  "keywords": [
    "electron",
    "facebook",
    "messenger",
    "desktop"
  ],
  "author": "Kristian Spasov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kristianinator/Unofficial_Messenger_Desktop.git"
  },
  "homepage": "https://github.com/kristianinator/Unofficial_Messenger_Desktop",
  "bugs": {
    "url": "https://github.com/kristianinator/Unofficial_Messenger_Desktop/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "electron": "39.2.7",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
